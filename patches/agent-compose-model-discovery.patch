+package adapters
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	appconfig "github.com/chaitin/agent-compose/pkg/config"
+	"github.com/chaitin/agent-compose/pkg/llms"
+)
+
+func TestCapabilitiesDiscoversModelsWithNoProtocolVerdict(t *testing.T) {
+	var requests atomic.Int64
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		requests.Add(1)
+		if r.Method != http.MethodGet || r.URL.Path != "/api/coding/paas/v4/models" {
+			t.Errorf("configuration read attempted inference: %s %s", r.Method, r.URL.Path)
+			http.NotFound(w, r)
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"data":[{"id":"glm-5"}]}`))
+	}))
+	defer server.Close()
+	provider := probeUpstreamProvider(server.URL)
+	provider.BaseURL = server.URL + "/api/coding/paas/v4/chat/completions"
+	provider.DefaultWireAPI = llms.APIProtocolChatCompletions
+	provider.Enabled = true
+	prober := NewLLMUpstreamProber(&appconfig.Config{LLMUpstreamProbe: true, LLMProbeTimeout: time.Second}, discardProbeLogger())
+	for i := 0; i < 2; i++ {
+		result, ok := prober.Capabilities(context.Background(), provider)
+		if !ok || len(result.Models) != 1 || result.Models[0] != "glm-5" || len(result.Protocols) != 0 {
+			t.Fatalf("capabilities = %#v, ok=%v", result, ok)
+		}
+	}
+	if requests.Load() != 1 {
+		t.Fatal("model discovery was not cached")
+	}
+	provider.Enabled = false
+	if _, ok := prober.Capabilities(context.Background(), provider); ok || requests.Load() != 1 {
+		t.Fatal("disabled provider exposed or fetched capabilities")
+	}
+}
