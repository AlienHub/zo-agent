diff --git a/pkg/llms/model_inventory.go b/pkg/llms/model_inventory.go
new file mode 100644
index 0000000..e3be74d
--- /dev/null
+++ b/pkg/llms/model_inventory.go
@@ -0,0 +1,46 @@
+package llms
+
+import (
+	"context"
+	"time"
+)
+
+// DiscoverModels refreshes the inventory without executing protocol probes or
+// model inference. Its cache is separate from protocol verdicts, so reading a
+// model list cannot suppress a subsequent real protocol check.
+func (p *UpstreamProber) DiscoverModels(ctx context.Context, provider Provider) (UpstreamProbeResult, bool) {
+	if p == nil || ctx.Err() != nil {
+		return UpstreamProbeResult{}, false
+	}
+	key := UpstreamProbeKey(provider)
+	if result, ok := p.inventory.Lookup(key); ok {
+		return result, true
+	}
+	pending := p.inventoryRequests.DoChan(key, func() (any, error) {
+		if result, ok := p.inventory.Lookup(key); ok {
+			return result, nil
+		}
+		headers, err := ProviderForwardHeaders(provider)
+		if err != nil {
+			return nil, err
+		}
+		result := UpstreamProbeResult{Endpoint: redactedProbeEndpoint(provider.BaseURL), ProbedAt: time.Now().UTC()}
+		result.Models, result.ModelsDetail = p.listModels(ctx, provider, headers)
+		if ctx.Err() != nil {
+			return nil, ctx.Err()
+		}
+		// Cache bounded negative results too; an endpoint without /models should
+		// not be hammered whenever the settings screen re-renders.
+		p.inventory.Store(key, result)
+		return result, nil
+	})
+	select {
+	case <-ctx.Done():
+		return UpstreamProbeResult{}, false
+	case result := <-pending:
+		if result.Err != nil {
+			return UpstreamProbeResult{}, false
+		}
+		return result.Val.(UpstreamProbeResult), true
+	}
+}
