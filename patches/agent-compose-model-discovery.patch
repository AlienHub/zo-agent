@@ -0,0 +1,86 @@
+package llms
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"reflect"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func TestModelInventoryRefreshesAfterExpiryWithoutInference(t *testing.T) {
+	var requests atomic.Int64
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		requests.Add(1)
+		if r.Method != http.MethodGet || r.URL.Path != "/api/coding/paas/v4/models" || r.Header.Get("Authorization") != "Bearer test-secret" {
+			t.Errorf("unexpected inventory request: %s %s", r.Method, r.URL.Path)
+			http.NotFound(w, r)
+			return
+		}
+		writeProbeJSON(w, `{"data":[{"id":"glm-5"},{"id":"glm-5.3"}]}`)
+	}))
+	defer server.Close()
+	provider := probeTestProvider(server.URL + "/api/coding/paas/v4/chat/completions")
+	provider.DefaultWireAPI = APIProtocolChatCompletions
+	provider.APIKey = "test-secret"
+	prober := NewUpstreamProber(server.Client())
+	current := time.Unix(0, 0)
+	prober.inventory.now = func() time.Time { return current }
+	for i := 0; i < 2; i++ {
+		result, ok := prober.DiscoverModels(context.Background(), provider)
+		if !ok || !reflect.DeepEqual(result.Models, []string{"glm-5", "glm-5.3"}) || len(result.Protocols) != 0 {
+			t.Fatalf("inventory = %#v, ok=%v", result, ok)
+		}
+	}
+	if requests.Load() != 1 {
+		t.Fatalf("cached inventory issued %d requests", requests.Load())
+	}
+	current = current.Add(ProbeCacheTTL)
+	if _, ok := prober.DiscoverModels(context.Background(), provider); !ok || requests.Load() != 2 {
+		t.Fatal("expired inventory did not refresh")
+	}
+	if _, ok := prober.LookupUpstreamProbe(provider); ok {
+		t.Fatal("inventory read masqueraded as a protocol probe")
+	}
+}
+
+func TestModelInventoryCancellationDoesNotCacheFailure(t *testing.T) {
+	var requests atomic.Int64
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		requests.Add(1)
+		writeProbeJSON(w, `{"data":[{"id":"glm-5"}]}`)
+	}))
+	defer server.Close()
+	prober := NewUpstreamProber(server.Client())
+	provider := probeTestProvider(server.URL + "/v1")
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if _, ok := prober.DiscoverModels(ctx, provider); ok || requests.Load() != 0 {
+		t.Fatal("cancelled inventory was fetched or cached")
+	}
+	if result, ok := prober.DiscoverModels(context.Background(), provider); !ok || len(result.Models) != 1 || requests.Load() != 1 {
+		t.Fatal("cancelled request prevented a later successful read")
+	}
+}
+
+func TestModelInventoryCachesUnsupportedEndpoint(t *testing.T) {
+	var requests atomic.Int64
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		requests.Add(1)
+		http.NotFound(w, r)
+	}))
+	defer server.Close()
+	prober := NewUpstreamProber(server.Client())
+	provider := probeTestProvider(server.URL + "/v1")
+	for i := 0; i < 2; i++ {
+		result, ok := prober.DiscoverModels(context.Background(), provider)
+		if !ok || len(result.Models) != 0 || result.ModelsDetail != "HTTP 404" {
+			t.Fatalf("unsupported inventory = %#v, ok=%v", result, ok)
+		}
+	}
+	if requests.Load() != 1 {
+		t.Fatal("unsupported endpoint was not negatively cached")
+	}
+}
